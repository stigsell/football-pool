{
  "name": "football-pool",
  "version": "0.1.0",
  "homepage": "http://sieglfootballpool.com",
  "private": true,
  "dependencies": {
    "@babel/plugin-proposal-private-property-in-object": "^7.21.11",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "react": "^19.2.0",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.0",
    "react-scripts": "5.0.1",
    "react-use": "^17.6.0",
    "web-vitals": "^5.1.0",
    "xlsx": "^0.18.5"
  },
  "scripts": {
    "predeploy": "npm run test && npm run build && cp CNAME build/CNAME",
    "deploy": "gh-pages -d build",
    "prestart": "node scripts/check-spreadsheet.js",
    "start": "react-scripts start",
    "check:spreadsheet": "node scripts/check-spreadsheet.js",
    "build": "react-scripts build",
    "test": "react-scripts test --watchAll=false --coverage --collectCoverageFrom='src/**/*.{js,jsx,ts,tsx}'",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ],
    "rules": {
      "@typescript-eslint/no-unused-vars": ["error", {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }],
      "@typescript-eslint/consistent-type-imports": ["warn", {
        "prefer": "type-imports"
      }],
      "@typescript-eslint/no-explicit-any": "warn",
      "react/jsx-no-leaked-render": ["warn", {
        "validStrategies": ["ternary", "coerce"]
      }],
      "react-hooks/exhaustive-deps": "warn",
      "no-console": ["warn", { "allow": ["warn", "error"] }],
      "eqeqeq": ["error", "always"],
      "prefer-const": "error",
      "no-var": "error"
    }
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.0.10",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "baseline-browser-mapping": "^2.9.17",
    "gh-pages": "^6.3.0",
    "typescript": "^4.9.5"
  },
  "jest": {
    "coveragePathIgnorePatterns": [
      "src/index.tsx",
      "src/reportWebVitals.ts",
      "src/types/index.ts"
    ]
  }
}
